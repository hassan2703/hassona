# Copy to .env.local for local development, and add the same keys in
# Vercel > Project > Settings > Environment Variables for production.
# Every key is optional: without Sanity the site runs on the built-in
# placeholder content in src/content/seed.ts.

# Public URL of the live site (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://hassanbadawy.vercel.app

# Sanity (the admin panel at /studio). Find these at sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret shared with the Sanity webhook so publishing updates the live site
# instantly. Any long random string. Server only: never prefix with NEXT_PUBLIC.
SANITY_REVALIDATE_SECRET=
